{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "revision",
    "displayUnits",
    "geometry",
    "study",
    "namedSelections"
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "displayUnits": {
      "enum": ["m", "mm"]
    },
    "geometry": {
      "anyOf": [
        {
          "$ref": "#/definitions/EmptyGeometry"
        },
        {
          "$ref": "#/definitions/NumericalGeometry"
        },
        {
          "$ref": "#/definitions/CadGeometry"
        }
      ]
    },
    "study": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/LinearStaticStudy"
        }
      ]
    },
    "namedSelections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/definitions/NamedSelection"
      }
    }
  },
  "definitions": {
    "Regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/BoundaryId"
      }
    },
    "Vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "Constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "regions", "components"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "regions": {
          "$ref": "#/definitions/Regions"
        },
        "components": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": ["number", "null"]
          }
        }
      }
    },
    "Load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "regions", "kind", "vector", "pressure"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "regions": {
          "$ref": "#/definitions/Regions"
        },
        "kind": {
          "enum": ["force", "pressure", "traction"]
        },
        "vector": {
          "$ref": "#/definitions/Vector"
        },
        "pressure": {
          "type": "number"
        },
        "traction": {
          "anyOf": [
            {
              "$ref": "#/definitions/AffineTraction"
            },
            {
              "$ref": "#/definitions/KirschTraction"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "traction"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["traction"],
        "properties": {
          "traction": {
            "anyOf": [
              {
                "$ref": "#/definitions/AffineTraction"
              },
              {
                "$ref": "#/definitions/KirschTraction"
              }
            ]
          }
        }
      }
    },
    "PinnConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layers",
        "width",
        "activation",
        "optimizer",
        "learningRate",
        "steps",
        "interiorPoints",
        "boundaryPoints",
        "seed",
        "device",
        "formulation"
      ],
      "properties": {
        "layers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "width": {
          "type": "integer",
          "minimum": 4,
          "maximum": 128
        },
        "activation": {
          "const": "tanh"
        },
        "optimizer": {
          "const": "adam"
        },
        "learningRate": {
          "type": "number",
          "minimum": 1e-6,
          "maximum": 0.05
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "interiorPoints": {
          "type": "integer",
          "minimum": 8,
          "maximum": 4096
        },
        "boundaryPoints": {
          "type": "integer",
          "minimum": 4,
          "maximum": 1024
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "device": {
          "enum": ["auto", "cpu", "mps", "cuda"]
        },
        "formulation": {
          "enum": ["strong-form", "potential-energy"]
        }
      }
    },
    "BoundaryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "Point2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": -1000,
        "maximum": 1000
      }
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outer", "holes"],
      "properties": {
        "outer": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/ProfileSegment"
          }
        },
        "holes": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/ProfileHole"
          }
        }
      }
    },
    "ProfileSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "start", "end"],
      "properties": {
        "id": {
          "$ref": "#/definitions/BoundaryId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "enum": ["line", "arc"]
        },
        "start": {
          "$ref": "#/definitions/Point2"
        },
        "end": {
          "$ref": "#/definitions/Point2"
        },
        "center": {
          "$ref": "#/definitions/Point2"
        },
        "clockwise": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "arc"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["center", "clockwise"],
        "properties": {
          "center": {
            "$ref": "#/definitions/Point2"
          },
          "clockwise": {
            "type": "boolean"
          }
        }
      }
    },
    "ProfileHole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "center", "radius"],
      "properties": {
        "id": {
          "$ref": "#/definitions/BoundaryId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "center": {
          "$ref": "#/definitions/Point2"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      }
    },
    "AffineTraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "xx", "yy", "xy"],
      "properties": {
        "kind": {
          "const": "affine"
        },
        "xx": {
          "$ref": "#/definitions/Vector"
        },
        "yy": {
          "$ref": "#/definitions/Vector"
        },
        "xy": {
          "$ref": "#/definitions/Vector"
        }
      }
    },
    "KirschTraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "radius", "center", "tension"],
      "properties": {
        "kind": {
          "const": "kirsch"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "center": {
          "$ref": "#/definitions/Point2"
        },
        "tension": {
          "type": "number"
        }
      }
    },
    "NamedSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "geometryKind", "dimension", "regions"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "geometryKind": {
          "enum": ["box", "cylinder", "bracket", "profile"]
        },
        "dimension": {
          "enum": ["2d", "3d"]
        },
        "regions": {
          "$ref": "#/definitions/Regions"
        }
      }
    },
    "NumericalGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "length", "width", "height", "radius", "thickness"],
      "properties": {
        "kind": {
          "enum": ["box", "cylinder", "bracket", "profile"]
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "profile": {
          "$ref": "#/definitions/Profile"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "profile"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["profile"],
        "properties": {
          "profile": {
            "$ref": "#/definitions/Profile"
          }
        }
      }
    },
    "LinearStaticStudy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "material",
        "mesh",
        "constraints",
        "loads",
        "dimension",
        "formulation",
        "thickness",
        "solver"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "const": "linear-static"
        },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "young", "poisson"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "young": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000000000000.0
            },
            "poisson": {
              "type": "number",
              "exclusiveMinimum": -1,
              "maximum": 0.45
            }
          }
        },
        "mesh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size"],
          "properties": {
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            "boundarySize": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            }
          }
        },
        "constraints": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/Constraint"
          }
        },
        "loads": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/Load"
          }
        },
        "dimension": {
          "enum": ["2d", "3d"]
        },
        "formulation": {
          "enum": ["plane-stress", "solid"]
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "solver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pinn"],
          "properties": {
            "kind": {
              "enum": ["fem", "pinn"]
            },
            "pinn": {
              "$ref": "#/definitions/PinnConfiguration"
            }
          }
        }
      }
    },
    "EmptyGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dimension"],
      "properties": {
        "kind": {
          "const": "empty"
        },
        "dimension": {
          "enum": ["2d", "3d"]
        }
      }
    },
    "NativeAssetMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "originalName", "sha256", "byteLength"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "kind": {
          "const": "step-source"
        },
        "originalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^/\\\\]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "CadImportFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "assetId", "scaleFactor"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "const": "import-step"
        },
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "scaleFactor": {
          "type": "number",
          "minimum": 1e-12,
          "maximum": 1000000000000.0
        }
      }
    },
    "CadSketchFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "plane", "sketch"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "const": "sketch"
        },
        "plane": {
          "enum": ["xy", "xz", "yz"]
        },
        "sketch": {
          "$ref": "#/definitions/CadSketchDefinition"
        }
      }
    },
    "CadBoxFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "length", "width", "height"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "const": "box"
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      }
    },
    "CadCylinderFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "radius", "length"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "const": "cylinder"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      }
    },
    "CadExtrudeFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "sketchId", "distance"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "const": "extrude"
        },
        "sketchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "distance": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000,
          "not": {
            "const": 0
          }
        }
      }
    },
    "CadRevolveFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "sketchId", "axisOrigin", "axisDirection", "angle"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "const": "revolve"
        },
        "sketchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "axisOrigin": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -1000,
            "maximum": 1000
          }
        },
        "axisDirection": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -1000,
            "maximum": 1000
          }
        },
        "angle": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 6.283185307179586
        }
      }
    },
    "CadBooleanFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "operation", "leftId", "rightId"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "const": "boolean"
        },
        "operation": {
          "enum": ["union", "cut", "intersect"]
        },
        "leftId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "rightId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "CadTransformFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "inputId",
        "translation",
        "axisOrigin",
        "axisDirection",
        "angle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "const": "transform"
        },
        "inputId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "translation": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -1000,
            "maximum": 1000
          }
        },
        "axisOrigin": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -1000,
            "maximum": 1000
          }
        },
        "axisDirection": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -1000,
            "maximum": 1000
          },
          "not": {
            "items": {
              "const": 0
            }
          }
        },
        "angle": {
          "type": "number",
          "minimum": -6.283185307179586,
          "maximum": 6.283185307179586
        }
      }
    },
    "CadFilletFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "inputId", "edgeIds", "radius"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "const": "fillet"
        },
        "inputId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "edgeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      }
    },
    "CadChamferFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "inputId", "edgeIds", "distance"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "const": "chamfer"
        },
        "inputId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "edgeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
