{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "revision",
    "displayUnits",
    "geometry",
    "study",
    "namedSelections"
  ],
  "properties": {
    "schemaVersion": {
      "const": 5
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "displayUnits": {
      "enum": ["m", "mm"]
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "length", "width", "height", "radius", "thickness"],
      "properties": {
        "kind": {
          "enum": ["box", "cylinder", "bracket", "profile"]
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "profile": {
          "$ref": "#/definitions/Profile"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "profile"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["profile"],
        "properties": {
          "profile": {
            "$ref": "#/definitions/Profile"
          }
        }
      }
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "material",
        "mesh",
        "constraints",
        "loads",
        "dimension",
        "formulation",
        "thickness",
        "solver"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "const": "linear-static"
        },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "young", "poisson"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "young": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000000000000.0
            },
            "poisson": {
              "type": "number",
              "exclusiveMinimum": -1,
              "maximum": 0.45
            }
          }
        },
        "mesh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size"],
          "properties": {
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            "boundarySize": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            }
          }
        },
        "constraints": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/Constraint"
          }
        },
        "loads": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/Load"
          }
        },
        "dimension": {
          "enum": ["2d", "3d"]
        },
        "formulation": {
          "enum": ["plane-stress", "solid"]
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "solver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pinn"],
          "properties": {
            "kind": {
              "enum": ["fem", "pinn"]
            },
            "pinn": {
              "$ref": "#/definitions/PinnConfiguration"
            }
          }
        }
      }
    },
    "namedSelections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/definitions/NamedSelection"
      }
    }
  },
  "definitions": {
    "Regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/BoundaryId"
      }
    },
    "Vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "Constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "regions", "components"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "regions": {
          "$ref": "#/definitions/Regions"
        },
        "components": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": ["number", "null"]
          }
        }
      }
    },
    "Load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "regions", "kind", "vector", "pressure"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "regions": {
          "$ref": "#/definitions/Regions"
        },
        "kind": {
          "enum": ["force", "pressure", "traction"]
        },
        "vector": {
          "$ref": "#/definitions/Vector"
        },
        "pressure": {
          "type": "number"
        },
        "traction": {
          "anyOf": [
            {
              "$ref": "#/definitions/AffineTraction"
            },
            {
              "$ref": "#/definitions/KirschTraction"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "traction"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["traction"],
        "properties": {
          "traction": {
            "anyOf": [
              {
                "$ref": "#/definitions/AffineTraction"
              },
              {
                "$ref": "#/definitions/KirschTraction"
              }
            ]
          }
        }
      }
    },
    "PinnConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layers",
        "width",
        "activation",
        "optimizer",
        "learningRate",
        "steps",
        "interiorPoints",
        "boundaryPoints",
        "seed",
        "device",
        "formulation"
      ],
      "properties": {
        "layers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "width": {
          "type": "integer",
          "minimum": 4,
          "maximum": 128
        },
        "activation": {
          "const": "tanh"
        },
        "optimizer": {
          "const": "adam"
        },
        "learningRate": {
          "type": "number",
          "minimum": 1e-6,
          "maximum": 0.05
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "interiorPoints": {
          "type": "integer",
          "minimum": 8,
          "maximum": 4096
        },
        "boundaryPoints": {
          "type": "integer",
          "minimum": 4,
          "maximum": 1024
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "device": {
          "enum": ["auto", "cpu", "mps", "cuda"]
        },
        "formulation": {
          "enum": ["strong-form", "potential-energy"]
        }
      }
    },
    "BoundaryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "Point2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": -1000,
        "maximum": 1000
      }
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outer", "holes"],
      "properties": {
        "outer": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/ProfileSegment"
          }
        },
        "holes": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/ProfileHole"
          }
        }
      }
    },
    "ProfileSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "start", "end"],
      "properties": {
        "id": {
          "$ref": "#/definitions/BoundaryId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "enum": ["line", "arc"]
        },
        "start": {
          "$ref": "#/definitions/Point2"
        },
        "end": {
          "$ref": "#/definitions/Point2"
        },
        "center": {
          "$ref": "#/definitions/Point2"
        },
        "clockwise": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "arc"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["center", "clockwise"],
        "properties": {
          "center": {
            "$ref": "#/definitions/Point2"
          },
          "clockwise": {
            "type": "boolean"
          }
        }
      }
    },
    "ProfileHole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "center", "radius"],
      "properties": {
        "id": {
          "$ref": "#/definitions/BoundaryId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "center": {
          "$ref": "#/definitions/Point2"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      }
    },
    "AffineTraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "xx", "yy", "xy"],
      "properties": {
        "kind": {
          "const": "affine"
        },
        "xx": {
          "$ref": "#/definitions/Vector"
        },
        "yy": {
          "$ref": "#/definitions/Vector"
        },
        "xy": {
          "$ref": "#/definitions/Vector"
        }
      }
    },
    "KirschTraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "radius", "center", "tension"],
      "properties": {
        "kind": {
          "const": "kirsch"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "center": {
          "$ref": "#/definitions/Point2"
        },
        "tension": {
          "type": "number"
        }
      }
    },
    "NamedSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "geometryKind", "dimension", "regions"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "geometryKind": {
          "enum": ["box", "cylinder", "bracket", "profile"]
        },
        "dimension": {
          "enum": ["2d", "3d"]
        },
        "regions": {
          "$ref": "#/definitions/Regions"
        }
      }
    }
  }
}
