{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "revision", "displayUnits", "geometry", "study"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "displayUnits": {
      "enum": ["m", "mm"]
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "length", "width", "height", "radius", "thickness"],
      "properties": {
        "kind": {
          "enum": ["box", "cylinder", "bracket"]
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      }
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "material",
        "mesh",
        "constraints",
        "loads",
        "dimension",
        "formulation",
        "thickness",
        "solver"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "const": "linear-static"
        },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "young", "poisson"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "young": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000000000000.0
            },
            "poisson": {
              "type": "number",
              "exclusiveMinimum": -1,
              "maximum": 0.45
            }
          }
        },
        "mesh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size"],
          "properties": {
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            }
          }
        },
        "constraints": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/Constraint"
          }
        },
        "loads": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/Load"
          }
        },
        "dimension": {
          "enum": ["2d", "3d"]
        },
        "formulation": {
          "enum": ["plane-stress", "solid"]
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "solver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pinn"],
          "properties": {
            "kind": {
              "enum": ["fem", "pinn"]
            },
            "pinn": {
              "$ref": "#/definitions/PinnConfiguration"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "enum": ["x0", "x1", "y0", "y1", "z0", "z1", "outer", "inner-x", "inner-y"]
      }
    },
    "Vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "Constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "regions", "components"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "regions": {
          "$ref": "#/definitions/Regions"
        },
        "components": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": ["number", "null"]
          }
        }
      }
    },
    "Load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "regions", "kind", "vector", "pressure"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "regions": {
          "$ref": "#/definitions/Regions"
        },
        "kind": {
          "enum": ["force", "pressure"]
        },
        "vector": {
          "$ref": "#/definitions/Vector"
        },
        "pressure": {
          "type": "number"
        }
      }
    },
    "PinnConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layers",
        "width",
        "activation",
        "optimizer",
        "learningRate",
        "steps",
        "interiorPoints",
        "boundaryPoints",
        "seed",
        "device"
      ],
      "properties": {
        "layers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "width": {
          "type": "integer",
          "minimum": 4,
          "maximum": 128
        },
        "activation": {
          "const": "tanh"
        },
        "optimizer": {
          "const": "adam"
        },
        "learningRate": {
          "type": "number",
          "minimum": 1e-6,
          "maximum": 0.05
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "interiorPoints": {
          "type": "integer",
          "minimum": 8,
          "maximum": 4096
        },
        "boundaryPoints": {
          "type": "integer",
          "minimum": 4,
          "maximum": 1024
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "device": {
          "enum": ["auto", "cpu", "mps", "cuda"]
        }
      }
    }
  }
}
