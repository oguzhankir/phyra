{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phyra",
  "version": "0.4.0",
  "identifier": "org.phyra.workbench",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Phyra",
        "width": 1440,
        "height": 960,
        "minWidth": 1080,
        "minHeight": 700,
        "backgroundColor": "#fafaf8"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "resources/engine/": "engine/",
      "resources/licenses/": "licenses/",
      "../notices/": "notices/",
      "../LICENSE": "LICENSE"
    },
    "category": "DeveloperTool",
    "shortDescription": "Engineering analysis with FEM and experimental Physics ML",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
